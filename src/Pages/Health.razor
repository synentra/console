@page "/health"
@inject SynentraApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Health</PageTitle>

<HeaderTitle Title="Synentra Health"
             Description="Live liveness/readiness status from health."
             Icon="@Icons.Material.Filled.MonitorHeart"
             IconColor="Color.Primary"
             IconSize="Size.Large" />

<!-- Toolbar -->
<MudStack Row="true"
          AlignItems="AlignItems.Center"
          Justify="Justify.SpaceBetween"
          Class="page-header mb-4"
          Wrap="Wrap.Wrap">

    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Spacing="1">

        <MudIcon Icon="@Icons.Material.Filled.Circle"
                 Size="Size.Small"
                 Color="@GetStatusColor()" />

        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Last checked:
            <strong>@GetLastCheckedText()</strong>
        </MudText>

    </MudStack>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Rounded.Refresh"
               OnClick="LoadHealthAsync"
               Disabled="_busy">

        @if (_busy)
        {
            <MudProgressCircular Size="Size.Small"
                                 Indeterminate="true"
                                 Class="me-2" />
            <span>Refreshing</span>
        }
        else
        {
            <span>Refresh</span>
        }

    </MudButton>

</MudStack>

<MudPaper Class="pa-4 glass-panel" Elevation="0">
    @if (_health is null)
    {
        <MudText Typo="Typo.body1" Class="mud-text-secondary">No health response loaded.</MudText>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Status</MudText>
                <MudChip T="string" Color="@(_health.Status.Equals("Healthy", StringComparison.OrdinalIgnoreCase) ? Color.Success : Color.Error)" Variant="Variant.Filled" Class="mt-1">
                    @_health.Status
                </MudChip>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Health Check Duration</MudText>
                <MudText Typo="Typo.h6" Class="mt-1">@_health.HealthCheckDuration</MudText>
            </MudItem>
        </MudGrid>
    }
</MudPaper>

@code {
    private HealthResponse? _health;
    private bool _busy;
    private DateTimeOffset? _lastChecked;

    protected override async Task OnInitializedAsync()
    {
        await LoadHealthAsync();
    }

    private async Task LoadHealthAsync()
    {
        _busy = true;
        try
        {
            _health = await Api.GetHealthAsync();
            _lastChecked = DateTimeOffset.Now;
            if (_health is null)
            {
                Snackbar.Add("Health endpoint did not return a valid payload.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            _lastChecked = DateTimeOffset.Now;
            Snackbar.Add($"Health request failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private Color GetStatusColor()
    {
        if (_health?.Status is null)
            return Color.Default;

        return _health.Status.Equals(
            "Healthy",
            StringComparison.OrdinalIgnoreCase)
            ? Color.Success
            : Color.Error;
    }

    private string GetLastCheckedText()
    {
        return _lastChecked?.ToLocalTime().ToString("HH:mm:ss") ?? "Never";
    }
}
