@page "/policies"
@inject SynentraApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Policies</PageTitle>

<div class="page-shell">
<div>
    <MudText Typo="Typo.h4" Class="fw-semibold page-title">Policies</MudText>
    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary page-subtitle">Browse policy catalog and inspect detailed rule definitions.</MudText>
</div>

<MudPaper Class="pa-4 glass-panel" Elevation="0">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h6">Policy List</MudText>
        <MudStack Row="true" Spacing="1">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowAddModal">Add</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Refresh" OnClick="LoadPoliciesAsync" Disabled="_busy">Refresh</MudButton>
        </MudStack>
    </MudStack>

    <div class="table-responsive">
    <MudTable Items="_policies" Dense="true" Hover="true" Loading="_busy" Elevation="0">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Owner</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.PolicyName</MudTd>
            <MudTd DataLabel="Owner">@context.Owner</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Actions">
                <MudStack Row="true" Spacing="0">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenDetailsModalAsync(context.PolicyName))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditModal(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeletePolicy(context.PolicyName))" />
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
    </div>
</MudPaper>
</div>

<MudDialog @bind-Visible="_showDetailsModal">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">Policy Details</MudText>

        @if (_selectedPolicy is null)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">No policy details available.</MudText>
        }
        else
        {
            <MudStack Spacing="1">
                <MudText><b>Name:</b> @_selectedPolicy.Name</MudText>
                <MudText><b>Owner:</b> @_selectedPolicy.Owner</MudText>
                <MudText><b>Description:</b> @_selectedPolicy.Description</MudText>
                <MudText><b>Default:</b> @_selectedPolicy.Default</MudText>
                <MudText><b>Created On:</b> @_selectedPolicy.CreatedOn?.ToString("u")</MudText>
            </MudStack>

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Rules (@_selectedPolicy.Rules.Count)</MudText>
            <div class="table-responsive">
            <MudTable Items="_selectedPolicy.Rules" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Action</MudTh>
                    <MudTh>Priority</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>@context.Action</MudTd>
                    <MudTd>@context.Priority</MudTd>
                </RowTemplate>
            </MudTable>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseDetailsModal">Close</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showEditModal">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">Edit Policy</MudText>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField Label="Name" Variant="Variant.Outlined" Value="_editorPolicyName" ReadOnly="true" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField Label="Owner" Variant="Variant.Outlined" @bind-Value="_editorOwner" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField Label="Description" Variant="Variant.Outlined" @bind-Value="_editorDescription" FullWidth="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SaveEditAsync">Save</MudButton>
        <MudButton Variant="Variant.Text" OnClick="CloseEditModal">Cancel</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showAddModal">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">Add Policy</MudText>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField Label="Name" Variant="Variant.Outlined" @bind-Value="_editorPolicyName" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField Label="Owner" Variant="Variant.Outlined" @bind-Value="_editorOwner" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField Label="Description" Variant="Variant.Outlined" @bind-Value="_editorDescription" FullWidth="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAddAsync">Save</MudButton>
        <MudButton Variant="Variant.Text" OnClick="CloseAddModal">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly List<PolicySummary> _policies = [];
    private PolicyDetails? _selectedPolicy;
    private bool _busy;
    private bool _showDetailsModal;
    private bool _showEditModal;
    private bool _showAddModal;
    private string _editorPolicyName = string.Empty;
    private string _editorOwner = string.Empty;
    private string _editorDescription = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPoliciesAsync();
    }

    private async Task LoadPoliciesAsync()
    {
        _busy = true;
        try
        {
            var response = await Api.GetPoliciesAsync(1, 100);
            _policies.Clear();
            if (response is not null)
            {
                _policies.AddRange(response.Items);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load policies: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenDetailsModalAsync(string policyName)
    {
        _busy = true;
        try
        {
            _selectedPolicy = await Api.GetPolicyAsync(policyName);
            if (_selectedPolicy is null)
            {
                Snackbar.Add("Policy detail response was empty.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load policy details: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }

        _showDetailsModal = true;
    }

    private void OpenEditModal(PolicySummary policy)
    {
        _editorPolicyName = policy.PolicyName;
        _editorOwner = policy.Owner;
        _editorDescription = policy.Description;
        _showEditModal = true;
    }

    private void ShowAddModal()
    {
        _editorPolicyName = string.Empty;
        _editorOwner = string.Empty;
        _editorDescription = string.Empty;
        _showAddModal = true;
    }

    private Task SaveAddAsync()
    {
        Snackbar.Add("Policy create API is not available in this console yet.", Severity.Info);
        _showAddModal = false;
        return Task.CompletedTask;
    }

    private Task SaveEditAsync()
    {
        Snackbar.Add("Policy update API is not available in this console yet.", Severity.Info);
        _showEditModal = false;
        return Task.CompletedTask;
    }

    private void DeletePolicy(string policyName)
    {
        Snackbar.Add($"Policy delete API is not available yet for '{policyName}'.", Severity.Info);
    }

    private void CloseDetailsModal()
    {
        _showDetailsModal = false;
    }

    private void CloseEditModal()
    {
        _showEditModal = false;
    }

    private void CloseAddModal()
    {
        _showAddModal = false;
    }
}
