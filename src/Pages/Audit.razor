@page "/audit"
@inject SynentraApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Audit</PageTitle>

<div class="page-shell">
<div>
    <MudText Typo="Typo.h4" Class="fw-semibold page-title">Audit</MudText>
    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary page-subtitle">Paginated audit logs and single record detail lookup.</MudText>
</div>

<MudPaper Class="pa-4 glass-panel" Elevation="0">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowAddModal">Add</MudButton>
        <MudNumericField T="int" Label="Page" Variant="Variant.Outlined" Min="1" @bind-Value="_page" Style="width: 110px;" />
        <MudNumericField T="int" Label="Page Size" Variant="Variant.Outlined" Min="1" Max="100" @bind-Value="_pageSize" Style="width: 130px;" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Refresh" OnClick="LoadAuditAsync" Disabled="_busy">Load</MudButton>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Total: @_totalCount</MudText>
    </MudStack>

    <div class="table-responsive">
    <MudTable Items="_entries" Dense="true" Hover="true" Loading="_busy" Elevation="0">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Agent</MudTh>
            <MudTh>Action</MudTh>
            <MudTh>Decision</MudTh>
            <MudTh>Timestamp</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="Agent">@context.AgentId</MudTd>
            <MudTd DataLabel="Action">@context.Action</MudTd>
            <MudTd DataLabel="Decision">@context.Decision</MudTd>
            <MudTd DataLabel="Timestamp">@context.Timestamp?.LocalDateTime.ToString("g")</MudTd>
            <MudTd DataLabel="Actions">
                <MudStack Row="true" Spacing="0">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenDetailsModalAsync(context.Id))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditModal(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAudit(context.Id))" />
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
    </div>
</MudPaper>
</div>

<MudDialog @bind-Visible="_showDetailsModal">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">Audit Detail</MudText>
        @if (_detailStatusCode > 0)
        {
            <MudChip T="int" Color="@(_detailStatusCode is >= 200 and < 300 ? Color.Success : Color.Error)" Class="mb-2">@_detailStatusCode</MudChip>
        }
        <MudTextField Value="_detailJson" Variant="Variant.Outlined" Lines="16" ReadOnly="true" FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseDetailsModal">Close</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showEditModal">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">Edit Audit Entry</MudText>
        <MudGrid>
            <MudItem xs="12" md="4"><MudTextField Label="ID" Variant="Variant.Outlined" Value="_editorId" ReadOnly="true" FullWidth="true" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField Label="Agent ID" Variant="Variant.Outlined" Value="_editorAgentId" ReadOnly="true" FullWidth="true" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField Label="Action" Variant="Variant.Outlined" @bind-Value="_editorAction" FullWidth="true" /></MudItem>
            <MudItem xs="12" md="12"><MudTextField Label="Decision" Variant="Variant.Outlined" @bind-Value="_editorDecision" FullWidth="true" /></MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SaveEditAsync">Save</MudButton>
        <MudButton Variant="Variant.Text" OnClick="CloseEditModal">Cancel</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showAddModal">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">Add Audit Entry</MudText>
        <MudGrid>
            <MudItem xs="12" md="4"><MudTextField Label="Agent ID" Variant="Variant.Outlined" @bind-Value="_editorAgentId" FullWidth="true" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField Label="Action" Variant="Variant.Outlined" @bind-Value="_editorAction" FullWidth="true" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField Label="Decision" Variant="Variant.Outlined" @bind-Value="_editorDecision" FullWidth="true" /></MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAddAsync">Save</MudButton>
        <MudButton Variant="Variant.Text" OnClick="CloseAddModal">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly List<AuditEntry> _entries = [];
    private int _page = 1;
    private int _pageSize = 25;
    private int _totalCount;
    private string _detailJson = string.Empty;
    private int _detailStatusCode;
    private bool _busy;
    private bool _showDetailsModal;
    private bool _showEditModal;
    private bool _showAddModal;
    private string _editorId = string.Empty;
    private string _editorAgentId = string.Empty;
    private string _editorAction = string.Empty;
    private string _editorDecision = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAuditAsync();
    }

    private async Task LoadAuditAsync()
    {
        _busy = true;
        try
        {
            var response = await Api.GetAuditAsync(_page, _pageSize);
            _entries.Clear();
            if (response is not null)
            {
                _entries.AddRange(response.Items);
                _totalCount = response.TotalCount;
            }
            else
            {
                _totalCount = 0;
                Snackbar.Add("Audit list returned no data.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load audit list: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenDetailsModalAsync(string id)
    {
        _busy = true;
        try
        {
            var result = await Api.GetAuditByIdAsync(id);
            _detailStatusCode = result.StatusCode;
            _detailJson = string.IsNullOrWhiteSpace(result.Body) ? "(empty response body)" : result.Body;

            if (!result.IsSuccessStatusCode)
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to load audit detail.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load audit detail: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }

        _showDetailsModal = true;
    }

    private void OpenEditModal(AuditEntry entry)
    {
        _editorId = entry.Id;
        _editorAgentId = entry.AgentId;
        _editorAction = entry.Action;
        _editorDecision = entry.Decision;
        _showEditModal = true;
    }

    private void ShowAddModal()
    {
        _editorId = string.Empty;
        _editorAgentId = string.Empty;
        _editorAction = string.Empty;
        _editorDecision = string.Empty;
        _showAddModal = true;
    }

    private Task SaveAddAsync()
    {
        Snackbar.Add("Audit create API is not available in this console yet.", Severity.Info);
        _showAddModal = false;
        return Task.CompletedTask;
    }

    private Task SaveEditAsync()
    {
        Snackbar.Add("Audit update API is not available in this console yet.", Severity.Info);
        _showEditModal = false;
        return Task.CompletedTask;
    }

    private void DeleteAudit(string id)
    {
        Snackbar.Add($"Audit delete API is not available yet for '{id}'.", Severity.Info);
    }

    private void CloseDetailsModal()
    {
        _showDetailsModal = false;
    }

    private void CloseEditModal()
    {
        _showEditModal = false;
    }

    private void CloseAddModal()
    {
        _showAddModal = false;
    }
}
