@page "/audit"
@inject SynentraApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Audit</PageTitle>

<MudText Typo="Typo.h4" Class="fw-semibold mb-1">Audit</MudText>
<MudText Typo="Typo.subtitle2" Class="mud-text-secondary mb-4">Paginated audit logs and single record detail lookup.</MudText>

<MudGrid>
    <MudItem xs="12" lg="7">
        <MudPaper Class="pa-4 glass-panel" Elevation="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
                <MudNumericField T="int" Label="Page" Variant="Variant.Outlined" Min="1" @bind-Value="_page" Style="width: 110px;" />
                <MudNumericField T="int" Label="Page Size" Variant="Variant.Outlined" Min="1" Max="100" @bind-Value="_pageSize" Style="width: 130px;" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Refresh" OnClick="LoadAuditAsync" Disabled="_busy">Load</MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Total: @_totalCount</MudText>
            </MudStack>

            <MudTable Items="_entries" Dense="true" Hover="true" Loading="_busy">
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>Agent</MudTh>
                    <MudTh>Action</MudTh>
                    <MudTh>Decision</MudTh>
                    <MudTh>Timestamp</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Id</MudTd>
                    <MudTd>@context.AgentId</MudTd>
                    <MudTd>@context.Action</MudTd>
                    <MudTd>@context.Decision</MudTd>
                    <MudTd>@context.Timestamp?.LocalDateTime.ToString("g")</MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => LoadDetailAsync(context.Id))">Detail</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="5">
        <MudPaper Class="pa-4 glass-panel" Elevation="0">
            <MudText Typo="Typo.h6" Class="mb-3">Audit Detail</MudText>
            <MudTextField Label="Audit ID" Variant="Variant.Outlined" @bind-Value="_detailId" FullWidth="true" Class="mb-2" />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Search" OnClick="LoadDetailAsync" Disabled="_busy">Get /Audit/{id}</MudButton>

            @if (_detailStatusCode > 0)
            {
                <MudStack Row="true" Spacing="1" Class="mt-3 mb-2">
                    <MudChip T="int" Color="@(_detailStatusCode is >= 200 and < 300 ? Color.Success : Color.Error)">@_detailStatusCode</MudChip>
                </MudStack>
            }

            <MudTextField Value="_detailJson" Variant="Variant.Outlined" Lines="16" ReadOnly="true" FullWidth="true" Class="mt-2" />
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private readonly List<AuditEntry> _entries = [];
    private int _page = 1;
    private int _pageSize = 25;
    private int _totalCount;
    private string _detailId = string.Empty;
    private string _detailJson = string.Empty;
    private int _detailStatusCode;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAuditAsync();
    }

    private async Task LoadAuditAsync()
    {
        _busy = true;
        try
        {
            var response = await Api.GetAuditAsync(_page, _pageSize);
            _entries.Clear();
            if (response is not null)
            {
                _entries.AddRange(response.Items);
                _totalCount = response.TotalCount;
            }
            else
            {
                _totalCount = 0;
                Snackbar.Add("Audit list returned no data.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load audit list: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task LoadDetailAsync(string id)
    {
        _detailId = id;
        return LoadDetailAsync();
    }

    private async Task LoadDetailAsync()
    {
        if (string.IsNullOrWhiteSpace(_detailId))
        {
            Snackbar.Add("Enter an audit ID.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.GetAuditByIdAsync(_detailId);
            _detailStatusCode = result.StatusCode;
            _detailJson = string.IsNullOrWhiteSpace(result.Body) ? "(empty response body)" : result.Body;

            if (!result.IsSuccessStatusCode)
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to load audit detail.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load audit detail: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
