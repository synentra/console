@page "/"

@inject SynentraApiClient Api
@inject ISnackbar Snackbar
@inject ConsoleState ConsoleState

<PageTitle>Dashboard</PageTitle>

<HeaderTitle Title="Dashboard"
             Description="Overview of your Synentra gateway"
             Icon="@Icons.Material.Filled.Home"
             IconColor="Color.Primary"
             IconSize="Size.Large" />

<MudGrid Spacing="2" Class="content-grid">

    <!-- Metrics -->
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="0" Class="glass-panel pa-3">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Agents
            </MudText>

            <MudText Typo="Typo.h4">
                @_agentCount
            </MudText>

            <MudButton StartIcon="@Icons.Material.Filled.SmartToy"
                           Color="Color.Primary"
                           Size="Size.Small" />
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="0" Class="glass-panel pa-3">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Pending HITL
            </MudText>

            <MudText Typo="Typo.h4">
                @_pendingHitl
            </MudText>

            <MudButton StartIcon="@Icons.Material.Filled.VerifiedUser"
                           Color="Color.Warning"
                           Size="Size.Small" />
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="0" Class="glass-panel pa-3">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Policies
            </MudText>

            <MudText Typo="Typo.h4">
                @_policyCount
            </MudText>

            <MudButton StartIcon="@Icons.Material.Filled.Policy"
                           Color="Color.Secondary"
                           Size="Size.Small" />
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="0" Class="glass-panel pa-3">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                System Status
            </MudText>

            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Spacing="1">
                <MudChip T="string"
                         Color="@GetHealthColor()"
                         Variant="Variant.Filled"
                         Size="Size.Small">
                    @_healthStatus
                </MudChip>

                <MudButton StartIcon="@Icons.Material.Filled.MonitorHeart"
                           Color="Color.Info"
                           Size="Size.Small" />
            </MudStack>
        </MudCard>
    </MudItem>

    <!-- Quick Actions -->
    <MudItem xs="12" md="6">
        <MudCard Elevation="0" Class="glass-panel pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">
                Quick Actions
            </MudText>

            <MudStack Row="true"
                      Spacing="1"
                      Wrap="Wrap.Wrap">

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.VpnKey"
                           Href="/tokens">
                    Issue Token
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.SmartToy"
                           Href="/agents">
                    Manage Agents
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.VerifiedUser"
                           Href="/hitl">
                    Review HITL
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.TravelExplore"
                           Href="/proxy">
                    Proxy Test
                </MudButton>
            </MudStack>
        </MudCard>
    </MudItem>

</MudGrid>


@code {
    private const int CountPage = 1;
    private const int RecentAuditLimit = 5;

    private int _agentCount;
    private int _pendingHitl;
    private int _policyCount;

    private string _healthStatus = "Unknown";

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        try
        {
            var agentsTask = Api.GetAgentsAsync(CountPage, CountPage);
            var hitlTask = Api.GetPendingHitlAsync(CountPage, CountPage);
            var policiesTask = Api.GetPoliciesAsync(CountPage, CountPage);
            var healthTask = Api.GetHealthAsync();

            await Task.WhenAll(
                agentsTask,
                hitlTask,
                policiesTask,
                healthTask
            );

            var agents = await agentsTask;
            var hitl = await hitlTask;
            var policies = await policiesTask;
            var health = await healthTask;

            _agentCount = agents?.TotalCount ?? 0;
            _pendingHitl = hitl?.TotalCount ?? 0;
            _policyCount = policies?.TotalCount ?? 0;
            _healthStatus = health?.Status ?? "Unreachable";
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to load dashboard data: {ex.Message}",
                Severity.Error);
        }
    }

    private Color GetHealthColor() =>
        _healthStatus.Equals("Healthy", StringComparison.OrdinalIgnoreCase)
            ? Color.Success
            : Color.Error;
}