@page "/policies"
@inject SynentraApiClient Api
@inject ISnackbar SnackBar
@inject IDialogService DialogService

<PageTitle>Policies</PageTitle>

<HeaderTitle Title="Managing policies"
             Description="This section enumerates all policies currently registered and available within the Synentra system."
             Icon="@Icons.Material.Filled.Policy"
             IconColor="Color.Primary"
             IconSize="Size.Large" />

<MudTable T="PolicySummary"
          ServerData="LoadData"
          Dense="true"
          Hover="true"
          Bordered="false"
          Striped="false"
          @ref="_table" LoadingProgressColor="Color.Primary">
    <ToolBarContent>
        <MudFab Color="Color.Surface"
                Size="@Size.Small"
                StartIcon="@Icons.Material.Filled.Refresh"
                class="ml-2"
                Label="Refresh"
                OnClick="Refresh" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Owner</MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name"><b>@context.PolicyName</b></MudTd>
        <MudTd DataLabel="Owner">@context.Owner</MudTd>
        <MudTd DataLabel="Description">@context.Description</MudTd>
        <MudTd DataLabel="Actions">
            <MudStack Row="true" Spacing="0">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small" OnClick="@(() => PolicyDetailsAsync(context))" />
            </MudStack>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No matching records found</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

