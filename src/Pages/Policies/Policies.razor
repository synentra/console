    private async Task<TableData<PolicySummary>> LoadData(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            var response = await Api.GetPoliciesAsync(state.Page + 1, state.PageSize);

            if (response is null)
            {
                SnackBar.Add("Failed to load policies: No response received.", Severity.Error);
                return new TableData<PolicySummary> { Items = [], TotalItems = 0 };
            }

            var totalCount = response.TotalCount;

            return new TableData<PolicySummary>
            {
                Items = response.Items,
                TotalItems = totalCount
            };
        }
        catch (Exception ex)
        {
            SnackBar.Add($"Exception occurred: {ex.Message}", Severity.Error);
            return new TableData<PolicySummary>
            {
                Items = [],
                TotalItems = 0
            };
        }
    }

    private async Task Refresh()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task PolicyDetailsAsync(PolicySummary policy)
    {
        var options = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            BackdropClick = false,
            CloseOnEscapeKey = false,
            BackgroundClass = "blur-dialog-background"
        };

        var parameters = new DialogParameters {
            { "PolicyName", policy.PolicyName },
        };

        await DialogService.ShowAsync<DetailsPolicyDialog>("Policy Details", parameters, options);
    }

